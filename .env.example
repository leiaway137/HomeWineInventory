# Local LLM Configuration
# Choose one provider: 'lmstudio', 'vllm', or 'ollama'

# LLM Provider
LLM_PROVIDER=lmstudio

# LM Studio (local - has vision support)
# Default: Qwen3.6-35B via LM Studio
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_IMAGE_MODEL=qwen3.6-35b

# vllm (remote - more powerful)
# Default: Qwen3.5-122B via vllm
# LLM_BASE_URL=http://192.168.1.151:8000/v1
# LLM_IMAGE_MODEL=qwen3.5-122b

# Ollama (alternative local option)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_IMAGE_MODEL=llava

# Server port
PORT=3000